{"id":"6b1a890100b0709d3893063cf7ef6e0524c7e78280b5f86517350d41b151f887","at":"2026-10-27T04:51:34Z","commit":"b9541d724f9b8e6bd225feeaf03ab95d61bbb76a","parents":["b9953d7d2c6488493a9769b16943d5596465e75aaf50c519a7d3bcdc74961902"],"op":"relate","type":"verifies","ends":[{"kind":"test","id":"Macaw.Plug.ClientIpTest: trusted peer: all entries trusted gives the left-most trusted one","hash":"e42de187"},{"kind":"spec","id":"spec/01-client-ip.md#plug-client-ip-rule","hash":"26ebd290"}],"by":"Doug ClymerOlson <doug@yarina.org>","note":"§2's fourth bullet: with every entry trusted (10.9.9.9, 10.1.1.1), the client is the left-most, 10.9.9.9.","basis":"review"}
